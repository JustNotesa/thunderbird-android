<?xml version="1.0" encoding="utf-8"?>
<!--
We explicitly set the background color in case this layout is inflated using a theme different from the app theme (via
the 'message view theme' setting).
-->
<com.fsck.k9.ui.messageview.MessageTopView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/message_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:layout_weight="1"
    android:background="?attr/colorSurfaceContainerLowest"
    tools:context=".messageview.MessageViewFragment"
    >

    <com.fsck.k9.view.NonLockingScrollView
        android:id="@+id/message_scrollview"
        android:layout_width="fill_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="fill_parent"
            android:layout_height="fill_parent"
            >

            <!-- Header area -->
            <include layout="@layout/message_view_header" />

            <View
                android:id="@+id/header_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginHorizontal="16dp"
                android:background="?attr/colorOutlineVariant"
                />

            <FrameLayout
                android:id="@+id/extra_header_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="4dp"
                android:visibility="gone"
                tools:visibility="visible"
                >

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/show_pictures"
                    style="?attr/materialButtonOutlinedStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="@string/message_view_show_remote_images_action"
                    app:icon="@drawable/ic_image"
                    />

            </FrameLayout>

            <Space
                android:id="@+id/line_of_death"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                />

            <com.fsck.k9.view.ToolableViewAnimator
                android:id="@+id/message_layout_animator"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:inAnimation="@anim/fade_in"
                android:outAnimation="@anim/fade_out"
                app:previewInitialChild="1"
                >

                <View
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="8dp"
                    >

                    <ProgressBar
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="30dp"
                        android:paddingBottom="30dp"
                        android:indeterminate="false"
                        android:id="@+id/message_progress"
                        android:max="1000"
                        tools:progress="300"
                        style="@android:style/Widget.Holo.ProgressBar.Horizontal"
                        />

                    <com.google.android.material.textview.MaterialTextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@id/message_progress"
                        android:layout_centerInParent="true"
                        android:id="@+id/message_progress_text"
                        android:text="@string/message_progress_text"
                        />

                </RelativeLayout>

                <FrameLayout
                    android:orientation="vertical"
                    android:id="@+id/message_container"
                    android:layout_width="fill_parent"
                    android:layout_height="wrap_content"
                    />

            </com.fsck.k9.view.ToolableViewAnimator>

        </LinearLayout>

    </com.fsck.k9.view.NonLockingScrollView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/download_remainder"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_marginHorizontal="16dp"
        android:text="@string/message_view_download_remainder"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:layout_width="fill_parent"
        tools:visibility="visible"
        />

    <!--
    Where the message header goes when the one-handed mode pins it above the toolbar: its divider and the header are
    moved in here at runtime (see MessageTopView.setHeaderAtBottom).
    -->
    <LinearLayout
        android:id="@+id/header_bottom_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="?attr/colorSurfaceContainerLowest"
        android:visibility="gone"
        >

        <!-- The one line the header folds into while the message is scrolled -->
        <LinearLayout
            android:id="@+id/header_compact_bar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/message_header_compact_height"
            android:background="?attr/selectableItemBackground"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            >

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/header_compact_subject"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Message subject"
                />

            <ImageView
                android:id="@+id/header_compact_reply"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="?attr/controlBackground"
                android:contentDescription="@string/reply_action"
                android:paddingHorizontal="12dp"
                tools:srcCompat="@drawable/ic_reply_all"
                />

            <ImageView
                android:id="@+id/header_compact_overflow"
                android:layout_width="40dp"
                android:layout_height="48dp"
                android:background="?attr/controlBackground"
                android:clickable="true"
                android:contentDescription="@string/abc_action_menu_overflow_description"
                android:focusable="true"
                android:paddingStart="6dp"
                android:paddingEnd="10dp"
                android:layout_marginEnd="6dp"
                app:srcCompat="@drawable/ic_more_vert"
                />

        </LinearLayout>

    </LinearLayout>

    <androidx.compose.ui.platform.ComposeView
        android:id="@+id/bottom_sheet_compose_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        />

</com.fsck.k9.ui.messageview.MessageTopView>
