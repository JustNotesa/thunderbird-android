<?xml version="1.0" encoding="utf-8"?>
<!-- The controls of the server search with one-handed mode: in the bottom area, directly above the search filters.
     What is only to be read (the state of the search) is in message_list_search_info, at the top. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:visibility="gone"
    tools:visibility="visible"
    >

    <include layout="@layout/message_list_search_scope" />

    <include
        layout="@layout/message_list_search_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        />

</LinearLayout>
