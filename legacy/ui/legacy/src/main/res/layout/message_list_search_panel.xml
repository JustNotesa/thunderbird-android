<?xml version="1.0" encoding="utf-8"?>
<!-- The state of the server search with one-handed mode: in the bottom area, directly above the search filters. The list
     of results then starts with the first hit. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_panel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="4dp"
    android:visibility="gone"
    tools:visibility="visible"
    >

    <include layout="@layout/message_list_search_scope" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal"
        >

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            >

            <ProgressBar
                android:id="@+id/search_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                />

            <ImageView
                android:id="@+id/search_status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:srcCompat="@drawable/ic_error"
                />

        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/search_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Server search: folder 12 of 290"
            />

    </LinearLayout>

    <include
        layout="@layout/message_list_search_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        />

</LinearLayout>
