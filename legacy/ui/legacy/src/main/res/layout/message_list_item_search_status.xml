<?xml version="1.0" encoding="utf-8"?>
<!-- The height must not depend on what is displayed. Otherwise the messages below would move while the server search
     is running or when it ends. That's why views that aren't needed are made invisible instead of removing them. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        >

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            >

            <ProgressBar
                android:id="@+id/search_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                />

            <ImageView
                android:id="@+id/search_status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:srcCompat="@drawable/ic_error"
                tools:tint="?attr/colorError"
                />

        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/search_status_text"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:lines="1"
            tools:text="Server search: folder 12 of 290"
            />

    </LinearLayout>

    <!-- Starts below the text of the title, next to the icon -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/search_status_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="8dp"
        >

        <LinearLayout
            android:id="@+id/search_status_progress_group"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            >

            <ProgressBar
                android:id="@+id/search_status_progress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                tools:max="290"
                tools:progress="11"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/search_status_folder"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="middle"
                android:singleLine="true"
                tools:text="Projects/Customers/2026"
                />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/search_status_detail"
                android:textAppearance="?attr/textAppearanceBodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:lines="1"
                tools:text="3 messages found. Latest: Quarterly report"
                />

        </LinearLayout>

        <!-- Uses the space that isn't taken up by the button -->
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/search_status_message"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:ellipsize="end"
            android:paddingBottom="4dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toTopOf="@id/search_contents_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/search_contents_button"
            style="@style/Widget.Material3.Button.TonalButton.Icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remote_search_contents_action"
            android:visibility="gone"
            app:icon="@drawable/ic_find_in_page"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>

</LinearLayout>
