<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".settings.SettingsListFragment"
    >

    <!-- Shown while searching: what was searched for and how many settings were found -->
    <LinearLayout
        android:id="@+id/settings_search_info"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="12dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        android:visibility="gone"
        tools:visibility="visible"
        >

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_search_breadcrumb"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone"
            tools:text="Display › Message list"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_search_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            tools:text="1 hit for “Star”"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_search_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="4dp"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="Some settings could not be searched."
            />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:scrollbars="vertical"
            tools:listitem="@layout/text_icon_list_item"
            />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/settings_search_results"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:scrollbars="vertical"
            android:visibility="gone"
            tools:listitem="@layout/settings_search_result_item"
            />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/settings_search_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true"
            android:visibility="gone"
            />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/settings_search_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:padding="24dp"
            android:text="@string/settings_search_no_results"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:visibility="gone"
            />

    </FrameLayout>

    <!-- Placed at the bottom of the content; the fragment moves it to the top when the one-handed mode is off -->
    <FrameLayout
        android:id="@+id/settings_search_field_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/windowBackground"
        android:paddingStart="16dp"
        android:paddingTop="8dp"
        android:paddingEnd="16dp"
        android:paddingBottom="8dp"
        >

        <EditText
            android:id="@+id/settings_search_field"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/settings_search_field_background"
            android:drawablePadding="12dp"
            android:hint="@string/settings_search_hint"
            android:importantForAutofill="no"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1"
            android:minHeight="48dp"
            android:paddingStart="16dp"
            android:paddingEnd="48dp"
            android:textAppearance="?attr/textAppearanceBodyLarge"
            tools:ignore="LabelFor"
            />

        <ImageButton
            android:id="@+id/settings_search_clear"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end|center_vertical"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/settings_search_clear"
            android:visibility="gone"
            app:tint="?attr/colorOnSurfaceVariant"
            />

    </FrameLayout>

</LinearLayout>
