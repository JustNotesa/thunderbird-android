<?xml version="1.0" encoding="utf-8"?>
<!-- What the search displays for reading, with one-handed mode: at the top of the screen, out of the thumb's reach.
     Nothing in here can be tapped. The things to operate are in message_list_search_panel at the bottom. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/search_info"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="false"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="8dp"
    android:visibility="gone"
    tools:visibility="visible"
    >

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/search_info_scope"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:visibility="gone"
        tools:text="Searching in “Inbox”"
        tools:visibility="visible"
        />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="24dp"
        android:orientation="horizontal"
        >

        <FrameLayout
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="12dp"
            >

            <ProgressBar
                android:id="@+id/search_status_spinner"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:indeterminate="true"
                />

            <ImageView
                android:id="@+id/search_status_icon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:visibility="gone"
                tools:srcCompat="@drawable/ic_error"
                />

        </FrameLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/search_status_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="3"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Server search: folder 12 of 290"
            />

    </LinearLayout>

</LinearLayout>
