<?xml version="1.0" encoding="utf-8"?>
<resources>
    <dimen name="widget_padding">8dp</dimen>
    <dimen name="highlight_radius">48dp</dimen>

    <dimen name="message_view_pager_page_margin">16dp</dimen>
    <dimen name="messageListSwipeThreshold">72dp</dimen>
    <!-- Navigation icon and overflow menu next to the search field of the search results -->
    <dimen name="messageListSearchResultsToolbarReservedWidth">120dp</dimen>
    <!-- Used to work out how many messages fill the screen. Rows are at least this high. -->
    <dimen name="messageListSmallestRowHeight">56dp</dimen>
    <dimen name="folderListSubfolderIndentation">24dp</dimen>
    <dimen name="messageListSwipeIconPadding">24dp</dimen>
    <dimen name="messageListSwipeTextPadding">12dp</dimen>

    <dimen name="messageListStartKeyline">72dp</dimen>
    <dimen name="messageListContactPictureSize">40dp</dimen>
    <dimen name="messageListHorizontalPadding">16dp</dimen>
    <dimen name="messageListFolderButtonSize">32dp</dimen>
    <dimen name="messageListFolderTouchTargetHeight">40dp</dimen>
    <dimen name="messageListFolderTouchTargetInset">4dp</dimen>
    <!-- The folder button is taller than the text line it is centered on. These keep it clear of the star above and
         inside the list item below. -->
    <dimen name="messageListFolderPreviewMinHeight">35dp</dimen>
    <dimen name="messageListFolderLineMinBottomSpace">7dp</dimen>

    <!-- The rows are separated by whitespace, not by a divider line: the background is inset and rounded. -->
    <dimen name="messageListItemBackgroundInset">8dp</dimen>
    <dimen name="messageListItemCornerRadius">16dp</dimen>

    <!-- Message list density: compact -->
    <dimen name="messageListCompactVerticalPadding">4dp</dimen>
    <dimen name="messageListCompactTextViewMargin">0dp</dimen>
    <item name="messageListCompactLineSpacingMultiplier" format="float" type="dimen">1.0</item>

    <!-- Message list density: default -->
    <dimen name="messageListDefaultVerticalPadding">12dp</dimen>
    <dimen name="messageListDefaultTextViewMargin">2dp</dimen>
    <item name="messageListDefaultLineSpacingMultiplier" format="float" type="dimen">1.1</item>

    <!-- Message list density: relaxed -->
    <dimen name="messageListRelaxedTextViewMargin">4dp</dimen>
    <dimen name="messageListRelaxedVerticalPadding">16dp</dimen>
    <item name="messageListRelaxedLineSpacingMultiplier" format="float" type="dimen">1.2</item>

    <!-- The account of a message, drawn as a label at the end of the subject. -->
    <dimen name="messageViewAccountLabelGapBefore">8dp</dimen>
    <dimen name="messageViewAccountLabelHorizontalPadding">8dp</dimen>
    <dimen name="messageViewAccountLabelVerticalPadding">2dp</dimen>
    <dimen name="messageViewAccountLabelDotSize">6dp</dimen>
    <dimen name="messageViewAccountLabelDotGap">4dp</dimen>
    <dimen name="messageViewAccountLabelTextSize">12sp</dimen>

    <dimen name="fakeAlignImageTopToTextTopPadding">4dp</dimen>

    <dimen name="floatingActionButtonMargin">16dp</dimen>
    <!-- Height of FloatingActionButton (56dp) plus two times floatingActionButtonMargin -->
    <dimen name="floatingActionButtonSpacing">88dp</dimen>

    <!-- Edit Identity -->
    <dimen name="edit_identity_screen_padding">16dp</dimen>
    <dimen name="edit_identity_screen_signature_layout_spacing">8dp</dimen>

    <!-- Message Compose -->
    <dimen name="message_compose_edit_signature_padding">24dp</dimen>
    <!-- Gap above and below the in-app notification banner; only present while a banner is shown. -->
    <dimen name="message_compose_banner_margin">8dp</dimen>
</resources>
