<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
    The labels and values of the composer's header, both as big as the body text of the theme. That size is spelled
    out instead of taken from the theme's body appearance: an appearance brings a colour of its own, and that colour
    would win over the colours set here.
    -->
    <style name="ComposeTextLabel" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <!-- The minimum width keeps the values of all header rows in one column. -->
        <item name="android:minWidth">50dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="ComposeEditText" parent="@android:style/TextAppearance.Medium">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="RecipientEditText" parent="ComposeEditText">
        <item name="android:lineSpacingExtra">4dp</item>
    </style>

    <!-- The one fine line that separates the header fields of the composer from each other. -->
    <style name="Widget.Composer.HeaderDivider" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:layout_marginStart">16dp</item>
        <item name="android:alpha">0.6</item>
        <item name="android:background">?attr/colorOutlineVariant</item>
    </style>

    <style name="MessageComposeHighlight">
        <item name="highlightBackgroundColor">#99444444</item>
    </style>

    <style name="PositiveBulletPoint">
        <item name="srcCompat">@drawable/ic_add_circle</item>
        <item name="android:tint">?attr/tintColorBulletPointPositive</item>
    </style>

    <style name="NeutralBulletPoint">
        <item name="srcCompat">@drawable/ic_adjust</item>
        <item name="android:tint">?attr/tintColorBulletPointNeutral</item>
    </style>

    <style name="NegativeBulletPoint">
        <item name="srcCompat">@drawable/ic_do_not_disturb_on</item>
        <item name="android:tint">?attr/tintColorBulletPointNegative</item>
    </style>

    <style name="AttachmentView" parent="">
        <item name="android:layout_width">match_parent</item>
    </style>

    <style name="AttachmentCard" parent="">
        <item name="android:layout_width">match_parent</item>
    </style>

</resources>

