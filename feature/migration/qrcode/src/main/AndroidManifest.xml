<?xml version="1.0" encoding="utf-8"?>
<manifest
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>

    <!-- Local-only hotspot of the account transfer: the sending device offers the container over its own Wi-Fi. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <!-- Starting a local-only hotspot is covered by the nearby devices permission from Android 13 on. -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="33"
        />
    <!-- Up to Android 12 the hotspot is tied to the location permission, the transfer never uses the location. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" android:maxSdkVersion="32"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" android:maxSdkVersion="32"/>
    <!-- Joining the hotspot of the sending device: a normal permission, granted when the app is installed. -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>

    <application tools:ignore="MissingApplicationIcon">
        <activity
            android:name=".ui.QrCodeScannerActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.Dark.NoActionBar"
            />

        <activity
            android:name=".ui.send.TransferSendActivity"
            android:exported="false"
            android:theme="@style/Theme.Material3.Light.NoActionBar"
            />

        <provider
            android:name=".settings.QrCodeSettingsFileProvider"
            android:authorities="${applicationId}.qrcode.settings"
            android:exported="false"
            android:grantUriPermissions="true"
            >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/migration_qrcode_file_provider_paths"
                />
        </provider>
    </application>

</manifest>
